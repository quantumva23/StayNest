{
  "name": "staynest-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "StayNest — Full-Stack Accommodation Booking Platform",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "npm run dev:server",
    "dev:docker": "sh scripts/dev.sh",
    "start:local": "sh scripts/dev.sh",
    "start": "npm --workspace=server run start",
    "start:server": "npm --workspace=server run start",
    "build:server": "npm --workspace=server run build",
    "build:client": "npm --workspace=client run build",
    "build": "npm run build:server && npm run build:client",
    "prisma:generate": "npm --workspace=server run prisma:generate",
    "prisma:deploy": "npm --workspace=server run prisma:deploy",
    "prisma:seed": "npm --workspace=server run prisma:seed",
    "test:server": "npm --workspace=server run test",
    "test": "npm run test:server"
  },
  "keywords": [
    "booking",
    "hotel",
    "reservation",
    "airbnb-clone",
    "full-stack",
    "express",
    "react",
    "prisma"
  ],
  "author": "",
  "license": "ISC"
}
