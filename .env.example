# ----------------------------------------------------
# StayNest Environment Configuration
# Copy this file to .env or configure in your deployment provider
# ----------------------------------------------------

# Environment & Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/staynest?schema=public"

# Supabase Auth Configuration (Required for cloud Supabase Auth verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Fallback Development JWT Secret (Used when running in offline/local mock auth mode)
JWT_SECRET=dev-jwt-secret-min-32-chars-long-staynest-booking-platform

# Payment Provider: 'razorpay' or 'sandbox_mock'
PAYMENT_PROVIDER=sandbox_mock
PAYMENT_KEY_ID=rzp_test_placeholder_key
PAYMENT_KEY_SECRET=rzp_test_placeholder_secret
PAYMENT_WEBHOOK_SECRET=rzp_test_webhook_secret

# Image Provider: 'cloudinary' or 'static'
IMAGE_PROVIDER=static
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Provider: 'console' or 'resend'
EMAIL_PROVIDER=console
EMAIL_API_KEY=

# Client public variables (Vite requires VITE_ prefix for frontend exposure)
VITE_API_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
